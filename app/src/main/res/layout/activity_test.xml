<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test / Debug"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/debugFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/surface"
        android:fontFamily="monospace"
        android:padding="14dp"
        android:text="Call detection: NOT CONNECTED\nCall type: —\nTimer: 00:00\nTimer status: STOPPED\nLast alert: Not yet triggered\nLast event: —"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Test mode (simulated call — no real call is made)"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/testDurationGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton android:id="@+id/test10s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="10s" android:textColor="@color/text_primary" />
        <RadioButton android:id="@+id/test30s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="30s" android:textColor="@color/text_primary" />
        <RadioButton android:id="@+id/test1m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="1m" android:textColor="@color/text_primary" />
        <RadioButton android:id="@+id/test5m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="5m" android:textColor="@color/text_primary" />
        <RadioButton android:id="@+id/test10m" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="10m" android:textColor="@color/text_primary" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/startTestButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="START TEST" />

        <Button
            android:id="@+id/endTestButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="End Test Call" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Event log"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <TextView
            android:id="@+id/eventLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
