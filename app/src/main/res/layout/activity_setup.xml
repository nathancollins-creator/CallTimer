<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions / Setup"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CallGuard needs access to phone-call state so it can detect when a call starts and ends and measure its duration. It does not need your contacts, location, microphone, messages, or call recordings — and there is no account of any kind."
            android:textColor="@color/text_secondary" />

        <!-- Phone state permission -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Phone state"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Lets CallGuard see whether a call is idle, ringing, or connected — nothing more. It cannot see who is calling, and it is never used to control or end a call."
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/phoneStateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="Status: NOT GRANTED"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/grantPhoneStateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Grant" />

        <!-- Notifications -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Notifications"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Needed to show the countdown and the warning/limit alerts. Required on Android 13 and newer."
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/notificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="Status: NOT GRANTED"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/grantNotificationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Grant" />

        <!-- Battery optimization -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Background reliability"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Some phones (Samsung especially) can aggressively stop background apps to save battery, even ones showing a notification. Exempting CallGuard from battery optimization makes it far more likely to keep watching for calls reliably. Only request this if you notice missed alerts — it isn't required for most phones."
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="Status: NOT EXEMPTED"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Exempt from battery optimization" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="On Samsung specifically, it also helps to open Settings → Apps → CallGuard → Battery, and make sure it is NOT set to &quot;Put app to sleep&quot; or included in any &quot;sleeping/deep-sleeping apps&quot; list under Settings → Battery → Background usage limits."
            android:textColor="@color/text_secondary"
            android:textStyle="italic" />

        <!-- Experimental: WhatsApp accessibility -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="EXPERIMENTAL — WhatsApp calls"
            android:textColor="@color/warn"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Off by default and separate from CallGuard's core cellular-call feature. WhatsApp has no official way for another app to detect its calls, so this uses Android's Accessibility service to watch WhatsApp's own on-screen call timer — it only looks at WhatsApp's screens, never reads or sends messages, and never taps or controls anything. It's also the most fragile part of the app (WhatsApp updates can break detection) and the kind of feature that invites extra scrutiny in a Google Play review. If you plan to publish CallGuard, leave this off."
            android:textColor="@color/text_secondary" />

        <CheckBox
            android:id="@+id/whatsappCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="false"
            android:text="Enable WhatsApp call timing (experimental)"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="Status: NOT ENABLED"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/enableAccessibilityButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enable Accessibility" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="After tapping Enable Accessibility: find &quot;CallGuard&quot; in the list that opens, turn it on, and confirm the system warning dialog. Both the checkbox above AND this Accessibility grant are required — either one alone does nothing."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
