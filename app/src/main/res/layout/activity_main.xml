<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="16dp"
            android:text="🔴 DISABLED"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:text="Not watching for calls"
            android:textColor="@color/text_secondary" />

        <!-- ===== CALL LIMIT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="CALL LIMIT"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callLimitDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="20:00"
            android:textColor="@color/primary"
            android:textSize="48sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/durationPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton android:id="@+id/duration5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 minutes" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/duration10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 minutes" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/duration15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 minutes" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/duration20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20 minutes (default)" android:textColor="@color/text_primary" android:checked="true" />
            <RadioButton android:id="@+id/duration30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 minutes" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/durationCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom:" android:textColor="@color/text_primary" />
        </RadioGroup>

        <EditText
            android:id="@+id/customDurationMinutes"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:hint="minutes"
            android:inputType="number"
            android:textColor="@color/text_primary" />

        <!-- ===== WARNING ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="WARNING"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/warning5MinCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="5 minutes before"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/warning1MinCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="1 minute before"
            android:textColor="@color/text_primary" />

        <!-- ===== WHEN LIMIT IS REACHED ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="WHEN LIMIT IS REACHED"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="✓ Alert only"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Automatically ending the call isn't offered in this version. Reliably ending a phone call on modern Android requires becoming the phone's full default calling app (dial pad, call screen, the works) — there's no lighter-weight way to do it. Rather than turn CallGuard into a complete phone app just for this one feature, it focuses on making the alert itself as dependable as possible instead."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Alert style:"
            android:textColor="@color/text_secondary" />

        <RadioGroup
            android:id="@+id/alertSoundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton android:id="@+id/alertDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Default alarm sound" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/alertSiren" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Siren" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/alertWarble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warble" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/alertSpoken" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spoken announcement" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/alertCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom ringtone (choose from phone)" android:textColor="@color/text_primary" />
        </RadioGroup>

        <TextView
            android:id="@+id/customRingtoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No ringtone chosen yet"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <Button
            android:id="@+id/chooseRingtoneButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose ringtone…"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/vibrateCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Vibrate"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/primary"
            android:text="ENABLE CALLGUARD"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/disableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/surface"
            android:text="DISABLE CALLGUARD"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/setupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Permissions / Setup" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test / Debug screen" />

    </LinearLayout>
</ScrollView>
